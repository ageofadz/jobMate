{
  "manifest_version": 3,
  "name": "JobMate Form Filler",
  "version": "0.2.1",
  "description": "In-browser Google job search, JobMate apply autofill, and API proxy for localhost.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>", "http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*", "https://www.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jobmate-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["apply-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
