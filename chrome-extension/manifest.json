{
  "manifest_version": 3,
  "name": "JobMate",
  "version": "1.0.7",
  "description": "Agentic browser assistant. Give it tasks, it figures out the rest.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobMate"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["tabs", "scripting", "storage", "unlimitedStorage", "tabGroups", "sidePanel", "debugger"],
  "host_permissions": ["<all_urls>", "http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*", "https://job-mate-theta.vercel.app/*", "https://www.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jobmate-app-url.js", "jobmate-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["apply-navigation.js", "apply-domain-playbook.js", "apply-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
