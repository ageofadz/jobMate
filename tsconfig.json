{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "jsx": "react-jsx",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": ["cli/**/*.ts", "cli/**/*.tsx", "lib/**/*.ts", "scripts/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
