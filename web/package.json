{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "zip-extension": "sh -c 'cd .. && rm -f web/public/chrome-extension.zip && zip -r web/public/chrome-extension.zip chrome-extension -x \"*.DS_Store\"'",
    "prebuild": "npm run zip-extension",
    "build": "react-router build",
    "build:ci": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@jlongster/sql.js": "^1.6.7",
    "@react-router/node": "7.15.0",
    "@react-router/serve": "7.15.0",
    "absurd-sql": "^0.0.54",
    "cheerio": "^1.2.0",
    "isbot": "^5.1.36",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.15.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
